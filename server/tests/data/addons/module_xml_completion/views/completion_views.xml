<odoo>
    <record id="completion_view_form" model="ir.ui.view">
        <field name="name">module_xml_completion.parent.form</field>
        <field name="model">module_xml_completion.parent</field>
        <field name="arch" type="xml">
            <form string="Parent">
                <field name="amo"/>
                <field name="line_ids">
                    <list>
                        <field name="line_am"/>
                    </list>
                </field>
                <field name="group_id" ref="base.group_us"/>
                <field name="partner_id" ref="base.group_us"/>
                <field name="partner_id" ref="module_xml_c"/>
                <field name="owner_id" ref="module_xml_completion.completion_par"/>
                <button name="action_completion_co" type="object"/>
                <button name="_completion_p" type="object"/>
                <button name="__completion_d" type="object"/>
                <button type="object" name=""/>
                <group groups="base.group_user,!base.group_us"/>
            </form>
        </field>
    </record>

    <record id="completion_view_list" model="ir.ui.view">
        <field name="arch" type="xml">
            <list string="Parents">
                <field name="tot"/>
            </list>
        </field>
        <field name="name">module_xml_completion.parent.list</field>
        <field name="model">module_xml_completion.parent</field>
    </record>

    <record id="completion_partner" model="res.partner">
        <field name="name">Completion Partner</field>
    </record>

    <delete model="res.partner" id="completion_partner"/>

    <asset id="completion_asset" name="Completion Asset">
        <field name="bundle">web.assets_backend</field>
        <field name="path">module_xml_completion/static/src/completion.js</field>
    </asset>

    <record id="completion_hover_probe" model="module_xml_completion.parent">
        <field name="group_id" ref="module_xml_completion.completion_partner"/>
        <field name="owner_id" ref="module_xml_completion.completion_asset"/>
    </record>

    <record id="completion_action_parent" model="ir.actions.act_window">
        <field name="name">Parents</field>
        <field name="res_model">module_xml_completion.parent</field>
    </record>

    <record id="completion_model_probe" model="module_xml_completion.pa"/>
    <record id="completion_rank_probe" model="module_"/>

    <record id="completion_text_probe" model="ir.ui.view">
        <field name="model">
            module_xml_completion.par
        </field>
    </record>

    <record id="completion_empty_text_probe" model="ir.ui.view"><field name="model"></field></record>

    <menuitem id="completion_menu_root" name="Completion"/>
    <menuitem id="completion_menu_other" name="Other"/>
    <menuitem id="completion_menu_child" name="Child" parent="module_xml_completion.completion_menu_ro" action="module_xml_completion.completion_action_par"/>
    <menuitem id="completion_menu_leaf" name="Leaf" parent="module_xml_completion.completion_menu_other"/>

    <template id="completion_template_base">
        <div>Base</div>
    </template>

    <template id="completion_template_child" inherit_id="module_xml_completion.completion_template_base"
        t-name="completion_child" t-inherit="module_xml_completion.completion_template_base">
        <div>Child</div>
    </template>

    <template id="completion_template_extra">
        <div>Extra</div>
    </template>

    <template id="completion_template_caller">
        <t t-call="module_xml_completion.completion_template_base"/>
        <t t-call="module_xml_completion.completion_template_ex"/>
        <t t-call="module_xml_completion.completion_template_child"/>
    </template>
</odoo>
