<odoo>
    <record id="subview_parent_view_form" model="ir.ui.view">
        <field name="name">module_xml_subview.parent.form</field>
        <field name="model">module_xml_subview.parent</field>
        <field name="arch" type="xml">
            <form string="Parent">
                <field name="amount"/>
                <field name="line_ids">
                    <list>
                        <field name="amount"/>
                    </list>
                </field>
                <field name="ref_id">
                    <form>
                        <field name="amount"/>
                    </form>
                </field>
            </form>
        </field>
    </record>

    <record id="subview_parent_view_list" model="ir.ui.view">
        <field name="name">module_xml_subview.parent.list</field>
        <field name="model">module_xml_subview.parent</field>
        <field name="arch" type="xml">
            <list string="Parents">
                <field name="amount"/>
                <groupby name="tag_id">
                    <field name="amount"/>
                </groupby>
            </list>
        </field>
    </record>

    <record id="subview_parent_view_modifiers" model="ir.ui.view">
        <field name="name">module_xml_subview.parent.modifiers</field>
        <field name="model">module_xml_subview.parent</field>
        <field name="arch" type="xml">
            <form string="Parent">
                <group invisible="not tag_id or uid">
                    <field name="line_ids" readonly="amount &lt; 0">
                        <list>
                            <field name="amount" column_invisible="parent.amount"/>
                            <field name="parent_id" decoration-danger="amount == 0"/>
                        </list>
                    </field>
                    <field name="amount" invisible="tag_id =="/>
                </group>
            </form>
        </field>
    </record>

    <record id="subview_parent_view_domains" model="ir.ui.view">
        <field name="name">module_xml_subview.parent.domains</field>
        <field name="model">module_xml_subview.parent</field>
        <field name="arch" type="xml">
            <form string="Parent">
                <field name="line_ids" domain="[('amount', '=', amount), ('parent_id.tag_id', '!=', False)]">
                    <list>
                        <field name="parent_id" domain="[('tag_id', '=', parent.amount)]"/>
                    </list>
                </field>
                <field name="tag_id" domain="[('amount',"/>
                <field name="line_ids" context="{'default_amount': tag_id, 'group_by': 'amount'}"/>
            </form>
        </field>
    </record>

    <record id="subview_parent_view_search" model="ir.ui.view">
        <field name="name">module_xml_subview.parent.search</field>
        <field name="model">module_xml_subview.parent</field>
        <field name="arch" type="xml">
            <search string="Parents">
                <filter name="tagged" domain="[('tag_id', '!=', False)]"/>
            </search>
        </field>
    </record>
</odoo>
